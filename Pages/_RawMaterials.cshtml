<section class="sheet tab-panel" id="raw-materials-panel" role="tabpanel" aria-labelledby="raw-materials-tab" aria-hidden="true" tabindex="0">
  <div class="panel-title"><span class="panel-step">02</span><div><h2>Raw Materials</h2><p>Material specification and preparation details</p></div></div>
  <div class="detail-grid raw-materials-grid">
    <section class="detail-card"><h3>Raw Material Details</h3><div class="detail-body fields four">
      <label>Specification<input name="materialSpecification"></label><label>Issue<input name="materialIssue"></label><label class="span-two">Description<input name="materialDescription"></label><label>MR no.<input name="mrNo"></label><label>Date<input name="materialDate" type="date"></label><label>Material type<input name="materialType"></label><label>Received condition<input name="receivedCondition"></label><label>Raw material size · dia<input name="rawMaterialDia"></label><label>Raw material size · length<input name="rawMaterialLength"></label><label>Batch no.<input name="rawMaterialBatchNo"></label><label>Alt. material / size<input name="alternativeMaterialSize"></label>
    </div></section>
    <section class="detail-card"><h3>Forging / Ring Rolling Details</h3><div class="detail-body fields four">
      <label>B.S. wt<input name="bsWeight"></label><label>Forg. wt<input name="forgingWeight"></label><label>Plant<input name="forgingPlant"></label><label>Batch no.<input name="forgingBatchNo"></label><label>Qty<input name="forgingQty" type="number" min="0"></label>
    </div></section>
  </div>
</section>