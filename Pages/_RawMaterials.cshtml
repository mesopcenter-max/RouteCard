<section class="sheet detail-section" aria-label="Raw Materials">
  <div class="panel-title"><span class="panel-step">02</span><div><h2>Raw Materials</h2><p>Material specification and preparation details</p></div></div>
  <div class="detail-grid raw-materials-grid">
    <section class="detail-card"><h3>Raw Material Details</h3><div class="detail-body fields four">
      <label>Specification<input name="materialSpecification"></label><label>ISS<input name="materialIssue"></label><label class="span-two">Description<input name="materialDescription"></label><label>MR no.<input name="mrNo"></label><label>Date<input name="materialDate" type="date"></label><label>Material type<input name="materialType"></label><label>Received condition<input name="receivedCondition"></label><label>Raw material size · dia<input name="rawMaterialDia"></label><label>Raw material size · length<input name="rawMaterialLength"></label><label>Alt. material size · dia<input name="alternativeMaterialSizeDia"></label><label>Alt. material size · length<input name="alternativeMaterialSizeLength"></label><label>Batch no.<input name="rawMaterialBatchNo"></label><label class="span-two">Raw Material Details e-sign<span class="e-sign-control"><select name="materialStamp" data-card-stamp-select data-approval-key="material" data-approval-name="Raw Material Details" aria-label="Raw material stamp"></select><input name="materialSign" aria-label="Raw material signature" readonly><input name="materialApprovedAt" type="date" aria-label="Raw material approval date"><button type="button" data-card-approve="material">E-sign</button><span class="print-card-stamp" aria-hidden="true"></span></span></label>
    </div></section>
    <section class="detail-card"><h3>Forging / Ring Rolling Details</h3><div class="detail-body fields four">
      <label>B.S. wt (kg)<input name="bsWeight"></label><label>Forg. wt (kg)<input name="forgingWeight"></label><label>Plant<input name="forgingPlant"></label><label>Batch no.<input name="forgingBatchNo"></label><label>Qty<input name="forgingQty" type="number" min="0"></label>
    </div></section>
    <section class="detail-card"><h3>Raw Material Ultrasonic Check</h3><div class="detail-body fields two">
      <label class="span-two">Raw Material Ultrasonic Check e-sign<span class="e-sign-control"><select name="ultrasonicStamp" data-card-stamp-select data-approval-key="ultrasonic" data-approval-name="Raw Material Ultrasonic Check" aria-label="Ultrasonic check stamp"></select><input name="ultrasonicSign" aria-label="Ultrasonic check signature" readonly><input name="ultrasonicApprovedAt" type="date" aria-label="Ultrasonic check approval date"><button type="button" data-card-approve="ultrasonic">E-sign</button><span class="print-card-stamp" aria-hidden="true"></span></span></label>
    </div></section>
  </div>
</section>