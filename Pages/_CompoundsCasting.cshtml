<section class="sheet tab-panel" id="compounds-panel" role="tabpanel" aria-labelledby="compounds-tab" aria-hidden="true" tabindex="0">
  <div class="panel-title"><span class="panel-step">03</span><div><h2>Compounds &amp; Casting</h2><p>Compound, casting and powder METT records</p></div></div>
  <div class="detail-grid two-up">
    <section class="detail-card"><h3>Rubber Compound</h3><div class="detail-body fields two">
      <label class="span-two">Specification<input name="rubberSpecification"></label><label>Date of mix<input name="rubberMixDate" type="date"></label><label>Date of expiry<input name="rubberExpiryDate" type="date"></label><label>Qty<input name="rubberQty" type="number" min="0"></label><label>Supplier<input name="rubberSupplier"></label>
    </div></section>
    <section class="detail-card"><h3>Rubber</h3><div class="detail-body fields two">
      <label>Batch no.<input name="rubberBatchNo"></label><label>LTR no. of rubber compound<input name="rubberLtrNo"></label>
    </div></section>
    <section class="detail-card"><h3>Casting Details</h3><div class="detail-body fields two">
      <label>UN FETT<input name="unFett"></label><label>FETT wt<input name="fettWeight"></label><label>Batch no.<input name="castingBatchNo"></label><label>Qty<input name="castingQty" type="number" min="0"></label>
    </div></section>
    <section class="detail-card"><h3>Powder METT Details</h3><div class="detail-body fields two">
      <label>PAD. wt<input name="padWeight"></label><label>Plating batch no.<input name="platingBatchNo"></label><label>Mix batch no.<input name="mixBatchNo"></label><label>Qty<input name="powderQty" type="number" min="0"></label>
    </div></section>
  </div>
  <div class="detail-card reference-card"><h3>Reference</h3><div class="detail-body fields two"><label>TA / PC ref.<input name="taPcRef"></label></div></div>
</section>