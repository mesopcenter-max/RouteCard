<section class="sheet detail-section" aria-label="Compounds &amp; Casting">
  <div class="panel-title"><span class="panel-step">03</span><div><h2>Compounds &amp; Casting</h2><p>Compound, casting and powder METT records</p></div></div>
  <div class="detail-grid two-up">
    <section class="detail-card"><h3>Rubber Compound</h3><div class="detail-body fields two">
      <label class="span-two">Specification<input name="rubberSpecification"></label><label>Date of mix<input name="rubberMixDate" type="date"></label><label>Date of expiry<input name="rubberExpiryDate" type="date"></label><label>Qty<input name="rubberQty" type="number" min="0"></label><label>Supplier<input name="rubberSupplier"></label><label class="span-two">Rubber Compound e-sign<span class="e-sign-control"><select name="rubberCompoundStamp" data-card-stamp-select data-approval-key="rubberCompound" data-approval-name="Rubber Compound" aria-label="Rubber compound stamp"></select><input name="rubberCompoundSign" aria-label="Rubber compound signature" readonly><input name="rubberCompoundApprovedAt" type="date" aria-label="Rubber compound approval date"><button type="button" data-card-approve="rubberCompound">E-sign</button><span class="print-card-stamp" aria-hidden="true"></span></span></label>
    </div></section>
    <section class="detail-card"><h3>Rubber</h3><div class="detail-body fields two">
      <label>Batch no.<input name="rubberBatchNo"></label><label>LTR no. of rubber compound<input name="rubberLtrNo"></label><label class="span-two">Rubber e-sign<span class="e-sign-control"><select name="rubberStamp" data-card-stamp-select data-approval-key="rubber" data-approval-name="Rubber" aria-label="Rubber stamp"></select><input name="rubberSign" aria-label="Rubber signature" readonly><input name="rubberApprovedAt" type="date" aria-label="Rubber approval date"><button type="button" data-card-approve="rubber">E-sign</button><span class="print-card-stamp" aria-hidden="true"></span></span></label>
    </div></section>
    <section class="detail-card"><h3>Casting Details</h3><div class="detail-body fields two">
      <label>UN. FETT (kg)<input name="unFett"></label><label>FETT wt (kg)<input name="fettWeight"></label><label>Batch no.<input name="castingBatchNo"></label><label>Qty<input name="castingQty" type="number" min="0"></label><label class="span-two">Casting Details e-sign<span class="e-sign-control"><select name="castingStamp" data-card-stamp-select data-approval-key="casting" data-approval-name="Casting Details" aria-label="Casting stamp"></select><input name="castingSign" aria-label="Casting signature" readonly><input name="castingApprovedAt" type="date" aria-label="Casting approval date"><button type="button" data-card-approve="casting">E-sign</button><span class="print-card-stamp" aria-hidden="true"></span></span></label>
    </div></section>
    <section class="detail-card"><h3>Powder METT Details</h3><div class="detail-body fields two">
      <label>PAD. wt (kg)<input name="padWeight"></label><label>Plating batch no.<input name="platingBatchNo"></label><label>Mix batch no.<input name="mixBatchNo"></label><label>Qty<input name="powderQty" type="number" min="0"></label><label class="span-two">Powder METT Details e-sign<span class="e-sign-control"><select name="powderStamp" data-card-stamp-select data-approval-key="powder" data-approval-name="Powder METT Details" aria-label="Powder METT stamp"></select><input name="powderSign" aria-label="Powder METT signature" readonly><input name="powderApprovedAt" type="date" aria-label="Powder METT approval date"><button type="button" data-card-approve="powder">E-sign</button><span class="print-card-stamp" aria-hidden="true"></span></span></label>
    </div></section>
  </div>
</section>