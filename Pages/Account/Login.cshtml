@page
@model HALRouteCardApp.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>HAL OpCenter · Sign in</title>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body class="login-page">
  <main class="login-card">
    <img class="login-logo" src="~/images/hal-logo.png" alt="Hindustan Aeronautics Limited">
    <p class="login-kicker">Hindustan Aeronautics Limited</p>
    <h1>HAL OpCenter</h1>
    <p class="login-subtitle">Sign in to Route Card Management</p>
    <form method="post" autocomplete="off">
      <input type="hidden" asp-for="ReturnUrl">
      <label asp-for="Username">Username<input asp-for="Username" autocomplete="username" autofocus></label>
      <span asp-validation-for="Username"></span>
      <label asp-for="Password">Password<input asp-for="Password" type="password" autocomplete="current-password"></label>
      <span asp-validation-for="Password"></span>
      @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <p class="login-error">@Model.ErrorMessage</p> }
      <button type="submit" class="login-button">Sign in</button>
    </form>
    <p class="login-hint">Authorized users: Mani, Nithin and Uday</p>
  </main>
</body>
</html>
